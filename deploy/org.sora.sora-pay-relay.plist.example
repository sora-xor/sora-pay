<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>org.sora.sora-pay-relay</string>
  <key>ProgramArguments</key><array><string>__INSTALLATION_ROOT__/deploy/run-relay.sh</string></array>
  <key>UserName</key><string>REPLACE_WITH_DEDICATED_SERVICE_ACCOUNT</string>
  <key>Disabled</key><true/>
  <key>RunAtLoad</key><false/>
  <key>KeepAlive</key><false/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__INSTALLATION_ROOT__/private/service.log</string>
  <key>StandardErrorPath</key><string>__INSTALLATION_ROOT__/private/service-error.log</string>
</dict></plist>
